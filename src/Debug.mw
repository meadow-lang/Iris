use Std.Collections.Vector as V
use Std.String as S
use Iris.Tables (escapedRanges)

-- The code point written as 4 base-64 digits at `at` in the table.
fun codeAt at =
  let digit = \i -> toInt (stringByteAt escapedRanges (at + i)) - 48 in
  let rec go i acc = if i >= 4 then acc else go (i + 1) (acc * 64 + digit i) in
  go 0 0

-- Whether Rust writes `cp` as `\u{…}`: characters that are not printable, and
-- grapheme extenders. The table is ranges, first and last, 8 digits each.
fun escapedAsUnicode cp =
  let rec search lo hi =
    if lo >= hi then False
    else
      let mid = (lo + hi) / 2 in
      if cp < codeAt (mid * 8) then search lo mid
      else if cp > codeAt (mid * 8 + 4) then search (mid + 1) hi
      else True
  in search 0 (stringByteLength escapedRanges / 8)

fun hex n =
  let digits = "0123456789abcdef" in
  let rec go m acc =
    if m == 0 then acc else go (m / 16) (stringSlice digits (m % 16) (m % 16 + 1) ++ acc)
  in if n == 0 then "0" else go n ""

-- One character as Rust's `Debug` for strings writes it.
fun escapeChar c =
  let cp = charCode c in
  if cp == 0 then "\\0"
  else if cp == 9 then "\\t"
  else if cp == 13 then "\\r"
  else if cp == 10 then "\\n"
  else if cp == 92 then "\\\\"
  else if cp == 34 then "\\\""
  else if escapedAsUnicode cp then "\\u{${hex cp}}"
  else charsToString #[c]

-- `s` in double quotes, escaped as Rust's `{:?}` does.
@pub fun debugString s = "\"${S.join "" (V.map escapeChar (V.fromArray (stringToChars s)))}\""
