-- The port against the crate: every case in `Cases.mw`, whose expected results
-- came from calling lexopt itself, plus a few examples.
--
-- Every declaration carries `@cfg(test)`, as the tests are no part of the
-- package.

@cfg(test)
use Std.Test (assertEq)
@cfg(test)
use Std.Collections.Vector as V
@cfg(test)
use Std.String as S
@cfg(test)
use Iris.Cases (cases)
@cfg(test)
use Iris.Lexopt
@cfg(test)
use Iris.Debug (debugString)

@cfg(test)
fun num i n =
  let rec go k acc =
    if k >= n then acc else go (k + 1) (acc * 64 + (toInt (stringByteAt cases (i + k)) - 48))
  in (go 0 0, i + n)

@cfg(test)
fun str i =
  let len = fst (num i 3) in
  (stringSlice cases (i + 3) (i + 3 + len), i + 3 + len)

@cfg(test)
fun argText a =
  match a with
  | Arg.Short c -> "short ${charsToString #[c]}"
  | Arg.Long name -> "long ${name}"
  | Arg.Value v -> "value ${v}"

@cfg(test)
fun listText vs = "[${S.join "|" vs}]"

@cfg(test)
fun maybeText m = match m with | Just s -> "some ${s}" | None -> "none"

@cfg(test)
fun orError r f =
  match r with
  | Ok x -> f x
  | Err e -> "error ${errorMessage e}"

@cfg(test)
fun digitsOnly s =
  let n = stringByteLength s in
  let rec go i =
    i >= n or (toInt (stringByteAt s i) >= 48 and toInt (stringByteAt s i) <= 57 and go (i + 1))
  in n > 0 and go 0

-- Makes call `op`, reading anything it takes from `i`: what the port answers,
-- and where the case goes on.
@cfg(test)
fun call op p i =
  match op with
  | 0 ->
      let answer =
        orError (nextArg p) (\m ->
          match m with
          | Just a -> "${argText a} / ${errorMessage (unexpected a)}"
          | None -> "none")
      in (answer, i)
  | 1 -> (orError (value p) (\v -> "ok ${v}"), i)
  | 2 -> (orError (values p) listText, i)
  | 3 -> (maybeText (optionalValue p), i)
  | 4 -> (orError (rawArgs p) listText, i)
  | 5 -> (orError (rawPeek p) maybeText, i)
  | 6 ->
      (match str i with
       | (prefix, next) -> (orError (rawNextIf (S.startsWith prefix) p) maybeText, next))
  | 7 ->
      let answer =
        match tryRawArgs p with
        | Just rest -> "some ${listText rest}"
        | None -> "none"
      in (answer, i)
  | 8 ->
      (match num i 1 with
       | (on, next) -> let _ = setShortEquals (on == 1) p in ("", next))
  | 9 -> (maybeText (binName p), i)
  | _ ->
      let parse = \s -> if digitsOnly s then Ok (stringByteLength s) else Err "not a number" in
      (orError (value p) (\v -> orError (parseWith parse v) (\n -> "parsed ${n}")), i)

@cfg(test)
fun runCase i =
  let withName = num i 1 in
  let count = num (snd withName) 1 in
  let rec readArgs k at acc =
    if k >= fst count then (acc, at)
    else
      match str at with
      | (a, next) -> readArgs (k + 1) next (V.pushBack acc a)
  in match readArgs 0 (snd count) V.empty with
     | (args, at) ->
         let p = if fst withName == 1 then parserFromIter args else parserFromArgs args in
         let ops = num at 1 in
         let rec go k at2 want got =
           if k >= fst ops then (want, got, at2)
           else
             let op = num at2 1 in
             match call (fst op) p (snd op) with
             | (answer, after) ->
                 match str after with
                 | (expected, next) ->
                     go (k + 1) next (V.pushBack want expected) (V.pushBack got answer)
         in go 0 (snd ops) V.empty V.empty

@cfg(test)
fun check i n bad =
  if i >= stringByteLength cases then (n, bad)
  else
    match runCase i with
    | (want, got, next) ->
        check next (n + 1) (if want == got then bad else V.pushBack bad (n, want, got))

-- The number of cases, and the first few where the port differs.
@cfg(test)
@test fun resultsMatchTheCrate () =
  match check 0 0 V.empty with
  | (n, bad) -> assertEq (n, V.take bad 2) (4000, []) "cases where the port and lexopt differ"

@cfg(test)
@test fun examples () =
  let p = parserFromArgs ["-vn5", "--name=x", "file"] in
  let a = assertEq (nextArg p) (Ok (Just (Arg.Short 'v'))) "short" in
  let b = assertEq (nextArg p) (Ok (Just (Arg.Short 'n'))) "second short" in
  let c = assertEq (value p) (Ok "5") "attached value" in
  let d = assertEq (nextArg p) (Ok (Just (Arg.Long "name"))) "long" in
  let e = assertEq (value p) (Ok "x") "long value" in
  let f = assertEq (nextArg p) (Ok (Just (Arg.Value "file"))) "value" in
  let g = assertEq (nextArg p) (Ok None) "end" in
  assertEq (debugString "tab\t\u{301}") "\"tab\\t\\u{301}\"" "debug"
